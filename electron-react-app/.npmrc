node-linker = hoisted

# Resolve packages only from the intended registry and verify the local store.
registry = https://registry.npmjs.org/
verify-store-integrity = true

# Reject dependency graphs that hide peer dependency problems.
strict-peer-dependencies = true

# Give newly published packages time to be reviewed before resolution.
minimum-release-age = 10080

# Dependency lifecycle scripts must be explicitly allowlisted in package.json.
strict-dep-builds = true
